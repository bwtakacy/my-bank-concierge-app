# Anthropic API キー（必須）
ANTHROPIC_API_KEY=

# identity-linked API key（ユーザーに紐づけて発行したAPIキー）を使う場合のみ必須。
# 未設定だと "anthropic-workspace-id is required..." エラーになる。
# Anthropic Console > Settings > Workspaces で対象ワークスペースのIDを確認する
# （wrkspc_ から始まる文字列）。
ANTHROPIC_WORKSPACE_ID=

# フロントエージェント（対話管理・動的ルーティング）が使用するモデル
# 中位モデルを想定
ANTHROPIC_MODEL_FRONT=claude-sonnet-5

# 専門エージェント（Scout-then-actのAct段階での回答合成）が使用するモデル
# 中位モデルを想定
ANTHROPIC_MODEL_SPECIALIST=claude-sonnet-5

# 予備: 将来ルーティング補助や単純抽出にLLMを使う場合の軽量モデル
# （現在のデモでは決定的ルーターは正規表現ベースのためLLM呼び出しを行わないが、
#   拡張の余地として env に残してある）
ANTHROPIC_MODEL_ROUTER=claude-haiku-4-5-20251001
